{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-interop-contract-v1",
  "title": "Contrato de Interoperabilidad de Radares v1",
  "type": "object",
  "required": ["interop_version","radar_id","repository","implementation_stage","entity_hub","territory","sector","temporal_evidence","scores","exports"],
  "properties": {
    "interop_version": {"const":"1.0"},
    "radar_id": {"enum":["RADAR_CGR","RADAR_SII","RADAR_UAF","RADAR_PRESUPUESTO","RADAR_SANCIONES","RADAR_DELICTUAL"]},
    "repository": {"type":"string"},
    "implementation_stage": {"enum":["CONTRACT_V1_INSTALLED","ADAPTER_PARTIAL","INTEROP_READY"]},
    "entity_hub": {"type":"object"},
    "territory": {"type":"object"},
    "sector": {"type":"object"},
    "temporal_evidence": {"type":"object"},
    "scores": {"type":"object"},
    "exports": {"type":"array"}
  },
  "additionalProperties": true
}